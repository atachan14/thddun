{
  "framework": null,
  "installCommand": "echo no-install",
  "buildCommand": "echo no-build",
  "outputDirectory": "site",
  "redirects": [
    { "source": "/top.html", "destination": "/", "permanent": false },
    { "source": "/demo.html", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" }
      ]
    }
  ]
}
